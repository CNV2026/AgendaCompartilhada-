rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /agendamentos/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['nome','agencia','data','hora','horaFim','assunto','criadoPor','criadoEm'])
        && request.resource.data.keys().hasAll(['nome','agencia','data','hora','criadoPor'])
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 80
        && request.resource.data.agencia is string && request.resource.data.agencia.size() > 0 && request.resource.data.agencia.size() <= 80
        && request.resource.data.data is string && request.resource.data.data >= '2026-10-01' && request.resource.data.data <= '2026-12-31'
        && request.resource.data.hora is string && request.resource.data.hora.size() <= 5
        && (!('assunto' in request.resource.data) || (request.resource.data.assunto is string && request.resource.data.assunto.size() <= 300));
      allow update: if false;
      allow delete: if request.auth != null && resource.data.criadoPor == request.auth.uid;
    }
  }
}
